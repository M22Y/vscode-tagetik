{
    "name": "vscode-tagetik",
    "displayName": "VSCode Tagetik",
    "description": "A VS Code extension to interact with CCH Tagetik API",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:tagetik.queryBuilder",
        "onCommand:tagetik.runQuery",
        "onCommand:tagetik.addConnection",
        "onCommand:tagetik.refresh"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "tagetik.queryBuilder",
                "title": "Tagetik Query Builder"
            },
            {
                "command": "tagetik.runQuery",
                "title": "Run Tagetik Query"
            },
            {
                "command": "tagetik.addConnection",
                "title": "Add Tagetik Connection"
            },
            {
                "command": "tagetik.refresh",
                "title": "Refresh Tagetik Connections"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "tagetikTables",
                    "name": "Tagetik Tables"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "Tagetik API Settings",
            "properties": {
                "tagetik.apiUrl": {
                    "type": "string",
                    "default": "",
                    "description": "The base URL of the Tagetik API."
                },
                "tagetik.username": {
                    "type": "string",
                    "default": "",
                    "description": "The username for Tagetik API authentication."
                },
                "tagetik.password": {
                    "type": "string",
                    "default": "",
                    "description": "The password for Tagetik API authentication."
                },
                "tagetik.dbEngine": {
                    "type": "string",
                    "default": "Postgres",
                    "enum": ["Hana", "SQLServer", "Postgres"],
                    "description": "The database engine used by Tagetik."
                },
                "tagetik.connections": {
                    "type": "object",
                    "default": {},
                    "description": "Saved Tagetik connections"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/node": "^14.14.37",
        "@types/vscode": "^1.60.0",
        "typescript": "^4.2.3",
        "eslint": "^7.22.0",
        "eslint-plugin-vscode": "^1.2.0"
    },
    "dependencies": {
        "axios": "^0.21.1"
    }
}